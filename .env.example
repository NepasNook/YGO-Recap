# Copia questo file in `.env` e inserisci i valori del TUO progetto Supabase.
# Li trovi in Supabase → Project Settings → API.
#
# La "publishable key" (anon key) e' pensata per stare nel browser: finisce nel
# bundle JavaScript ed e' protetta dalle Row Level Security policy del database.
# NON aggiungere mai qui la service role key: bypassa tutte le RLS e va tenuta
# solo nei secret della piattaforma di deploy (es. `wrangler secret put`).

# Usate dal client (Vite le inietta a build time)
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"

# Stessi valori senza prefisso, usati come fallback lato server (SSR)
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="your-publishable-anon-key"
